# MongoDB connection string (required for quotations + admin panel)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=TraceTech

# Secret used to sign admin session tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Secret URL slug that exposes the hidden admin panel, e.g. /manage-9f3k
ADMIN_SLUG=manage

# Public copy of the slug so client components can detect admin routes (keep in sync with ADMIN_SLUG)
NEXT_PUBLIC_ADMIN_SLUG=manage
